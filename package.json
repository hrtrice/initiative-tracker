{
  "name": "initiative-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && tsc --noEmit && esbuild src/server/index.ts --bundle --platform=node --target=node22 --outfile=dist/server/index.cjs --external:express --external:ws",
    "start": "node dist/server/index.cjs",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test --config tests/e2e/playwright.config.ts",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "express": "^4.21.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.0.0",
    "jsqr": "^1.4.0",
    "railway": "^3.12.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
